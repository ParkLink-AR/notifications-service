ENVIRONMENT=development

# Las requests tienen que traer el secret del gateway o la key interna entre
# servicios. Tienen que coincidir con las del gateway y el resto.
GATEWAY_INTERNAL_SECRET=dev-gateway-secret-change-me
INTERNAL_SERVICE_KEY=dev-internal-key-change-me

# Base de datos propia del servicio (mapa usuario -> device tokens + eventos ya procesados).
DATABASE_URL=postgresql://parklink_notif:parklink_notif@localhost:5436/parklink_notif_db

# Bus de eventos compartido (mismo exchange que declaran gateway y booking-service).
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=parklink.events
NOTIFICATIONS_QUEUE=notifications.events

# auth-service: datos del usuario (email, staff de soporte).
AUTH_SERVICE_URL=http://localhost:8000

# Ruta al JSON de service account de Firebase (Console -> Configuracion del proyecto ->
# Cuentas de servicio -> Generar nueva clave privada). Si queda vacio, el envio de push
# corre en modo "solo log" (util para tests y para correr sin Firebase).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# Mail a la casilla de soporte cuando un usuario abre o responde un ticket
# (misma cuenta de Brevo que auth-service). Sin BREVO_API_KEY solo se loguea.
# ADMIN_PANEL_URL agrega un link "abrir en el panel".
BREVO_API_KEY=
EMAIL_FROM=no-reply@mail.parklink.com.ar
EMAIL_FROM_NAME=ParkLink Argentina
SUPPORT_INBOX_EMAIL=contacto@parklink.com.ar
ADMIN_PANEL_URL=

# El consumer de RabbitMQ arranca junto con la app. Ponelo en false en tests.
CONSUMER_ENABLED=true

HTTP_PORT=8000

# Sentry (reportes de errores). DSN vacío = apagado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
