ENVIRONMENT=development

# Base de datos propia del servicio (mapa usuario -> device tokens + eventos ya procesados).
DATABASE_URL=postgresql://parklink_notif:parklink_notif@localhost:5436/parklink_notif_db

# Bus de eventos compartido (mismo exchange que declaran gateway y booking-service).
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=parklink.events
NOTIFICATIONS_QUEUE=notifications.events

# Para resolver el propietario y el título de la cochera de un evento booking.confirmed.
PARKING_SERVICE_URL=http://localhost:3001
UPSTREAM_TIMEOUT_SECONDS=10

# Ruta al JSON de service account de Firebase (Console -> Configuracion del proyecto ->
# Cuentas de servicio -> Generar nueva clave privada). Si queda vacio, el envio de push
# corre en modo "solo log" (util para tests y para correr sin Firebase).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# El consumer de RabbitMQ arranca junto con la app. Ponelo en false en tests.
CONSUMER_ENABLED=true

HTTP_PORT=8000
